// Converts quat to Euler angles 
double getYaw(imu::Quaternion q)
{
  //Sine of yaw times cosine of pitch = that
  // q.w() instead of q.w because it has to go fetch the value 
  double siny_cosp = 2.0 * (q.w() * q.z(0 + q.x() * q.y()); // Calculates Left/Right positioning on flat grid
  // Cosine of yaw times cosine of pitch = that
  double cosy_cosp = 1.0 - 2.0 * (q.y() * q.y() + q.z() * q.z()); // Calculates Foward and Back positioning on flat grid
  // atan2 is arctan(atan), the 2 checks both numbers and their signs for a 4 quadrant map
  // arctan reverts distance on flat grid into steering angle (Raw spatial coordinates into a single usable angle ex: 45 degrees)
  return atan2(siny_cosp, cosy_cosp) * (180.0 / PI); //Converts from Radian to Degree
}

// Take data type imu::Quaternion named quat and deltaA_meters from rotary encoder
void ControlQuat(imu::Quaternion quat, float delta_meters)
{
  //Pack into custom Quat structure (current_orientation is under Quat type)
  current_orientation.w = quat.w();
  current_orientation.x = quat.x();
  current_orientation.y = quat.y();
  current_orientation.z = quat.z();

  //Lock reference orientation and yaw on first run
  if(!isReferenceSet)
  {
    reference_orientation = current_orientation;
    ref_yaw = getYaw(quat);
    isReferenceSet = true; 
    Serial.println("Reference heading locked");
  }


  double raw_yaw = getYaw(quat);
  double real_yaw = raw_yaw - ref_yaw; // Find angle of Yaw difference from starting point

  // Wraps around to negative or positive once beyond 180
  if(rel_yaw > 180.0) 
    rel_yaw -= 360.0;
  if(rel_yaw < -180.0) 
    rel_yaw += 360.0;

  // Dead Reckoning - Convert from degree to Radian 
  double headin_rad = rel_yaw * (PI / 180.0);
  pos_x += delta_meters * cos(heading_rad); // Measures how parallel to x
  pos_y += delta_meters * sin(heading_rad); // Measures if it moves perpindicular to y

  double drift_deg = angular_distance(refernce_orientation, current_orientation);

  static unsigned long previousMillis = 0;
  unsigned long currentMillis = millis();

  if(currentMillis - previousMillis >= 500)
  {
    previousMillis = currentMillis;
    Serial.print("Yaw: ");        Serial.print(rel_yaw, 2);
    Serial.print(" X: ");         Serial.print(pos_x, 3);
    Serial.print(" Y: ");         Serial.print(pos_y, 3);
    Serial.print(" Dist: ");      Serial.print(Distance, 3);
    Serial.print(" Drift3D: ");   Serial.println(drift_deg, 2);
  }
}

