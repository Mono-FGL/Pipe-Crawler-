//RTAB MAP only takes Quaternions

#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BNO055.h>
#include <utility/imumaths.h>

//Use Adafruit_BNO055 class to create variable called bno
// 55 is the arbitrary sensor ID number 
Adafruit_BNO055 bno = Adafruit_BNO055(55);

void setup() 
{
  Serial.begin(115200);
  if(!bno.begin())
  {
    //Problem detected
    Serial.print("BNO not found, check connection");
    while(1);
  }
  //Sets mode to IMU
  bno.setMode(OPERATION_MODE_IMUPLUS);
  delay(2000);

  //Uses external crystal for better accuracy
  bno.setExtCrystalUse(true);
}

void loop() 
{
    imu::Quaternion quat = bno.getQuat();

    //Disply data 
    Serial.print("qW: ");
    //Display x with 4 decimal places 
    Serial.print(quat.w(), 4);
    Serial.print("\t");
    Serial.print("qX: ");
    Serial.print(quat.x(), 4);
    Serial.print("\t");
    Serial.print("qY: ");
    Serial.print(quat.y(), 4);
    Serial.print("\t");
    Serial.print("qZ: ");
    Serial.print(quat.z(), 4);
    Serial.println("");
    delay(500);
}
