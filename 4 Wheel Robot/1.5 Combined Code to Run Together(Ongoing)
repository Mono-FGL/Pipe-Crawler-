//Main_Robot.ino
#include <DHT.h>
#include <Adafruit_Sensor.h>

//initiailize
DHT dht(2, DHT11);

//LCD 
#include <LiquidCrystal.h>

void setup(){
  Serial.begin(9600);
  SetupMotors();
  SetupDHT();
  dht.begin();
}


void loop(){
  ControlMotors();
  ControlDHT();
}

//LCD_Display.ino

//TempHumidSens.ino
void SetupDHT()
{
  Serial.println("Begin Test");
}

void ControlDHT()
{
  Serial.println();
  
  float temp = dht.readTemperature();
  float humidity = dht.readHumidity();
  
  Serial.print(F("Temperature: "));
  Serial.println(temp);
  Serial.print(F("Humidity: "));
  Serial.println(humidity);
  delay(2000);
}

//MotorControl.ino
void SetupMotors()
{
  Serial.begin(9600);

    // Pins for motor speed
  pinMode(2, OUTPUT);
  pinMode(3, OUTPUT);
  pinMode(4, OUTPUT);
  pinMode(5, OUTPUT);
  // Pins for HIGH or LOW
  pinMode(22, OUTPUT);
  pinMode(24, OUTPUT);
  pinMode(26, OUTPUT);
  pinMode(28, OUTPUT);
}

void ControlMotors()
{
  float x = analogRead(A2) - 237;
  float y = analogRead(A1) - 272;

  //GoingFoward
  if(y > 600)
  {
    digitalWrite(22, HIGH);
    digitalWrite(24, HIGH);
    digitalWrite(26, HIGH);
    digitalWrite(28, HIGH);
    //Turning
    if(x < 300)
    {
      analogWrite(3, 75);
      analogWrite(5, 75);
      analogWrite(2, 250);
      analogWrite(4, 250);

    digitalWrite(22, HIGH);
    digitalWrite(24, LOW);
    digitalWrite(26, HIGH);
    digitalWrite(28, LOW);
    }
    
    else if(x > 650)
    {
      analogWrite(2, 75);
      analogWrite(4, 75);
      analogWrite(3, 250);
      analogWrite(5, 250);
     
    digitalWrite(22, LOW);
    digitalWrite(24, HIGH);
    digitalWrite(26, LOW);
    digitalWrite(28, HIGH);
  
    }
    else
    {
      analogWrite(2, 200);
      analogWrite(4, 200);
      analogWrite(3, 200);
      analogWrite(5, 200);
    }
  }
  //GoingBacwards
  if(y < 300)
  {
    digitalWrite(22, LOW);
    digitalWrite(24, LOW);
    digitalWrite(26, LOW);
    digitalWrite(28, LOW);
    //Turning
    if(x < 300)
    {
      analogWrite(3, 75);
      analogWrite(5, 75);
      analogWrite(2, 250);
      analogWrite(4, 250);

    digitalWrite(22, HIGH);
    digitalWrite(24, LOW);
    digitalWrite(26, HIGH);
    digitalWrite(28, LOW);

    }
    else if(x > 650)
    {
      analogWrite(2, 75);
      analogWrite(4, 75);
      analogWrite(3, 250);
      analogWrite(5, 250);

    digitalWrite(22, LOW);
    digitalWrite(24, HIGH);
    digitalWrite(26, LOW);
    digitalWrite(28, HIGH);

    }
    else
    {
      analogWrite(2, 200);
      analogWrite(4, 200);
      analogWrite(3, 200);
      analogWrite(5, 200);
    }
  }
  //Staying Still
  if(y > 400 && y < 600)
  {
    analogWrite(2, 0);
    analogWrite(3, 0);
    analogWrite(4, 0);
    analogWrite(5, 0);
  }

  Serial.print(x);
  Serial.print("\t");
  Serial.println(y);
  delay(100);
}

//MillisFunction.ino
unsigned long previousMillis = 0;

void Millis(int interval) {
  unsigned long currentMillis = millis();

  if(currentMillis - previousMillis >= interval) {
    previousMillis = currentMillis;
  }
}

