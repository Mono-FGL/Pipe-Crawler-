void setup ()
{
  Serial.begin(9600);

    // Pins for motor speed
  pinMode(2, OUTPUT);
  pinMode(3, OUTPUT);
  pinMode(4, OUTPUT);
  pinMode(5, OUTPUT);
  // Pins for HIGH or LOW
  pinMode(22, OUTPUT);
  pinMode(24, OUTPUT);
  pinMode(26, OUTPUT);
  pinMode(28, OUTPUT);
}

void loop()
{
  float x = analogRead(A3) - 237;
  float y = analogRead(A4) - 272;

  //GoingFoward
  if(y > 600)
  {
    digitalWrite(22, HIGH);
    digitalWrite(24, HIGH);
    digitalWrite(26, HIGH);
    digitalWrite(28, HIGH);
    //Turning
    if(x < 430)
    {
      analogWrite(3, 80);
      analogWrite(5, 80);
    }
    else
    {
      analogWrite(3, 150);
      analogWrite(5, 150);
    }
    if(x > 530)
    {
      analogWrite(2, 80);
      analogWrite(4, 80);
    }
    else
    {
      analogWrite(2, 150);
      analogWrite(4, 150);
    }
  }
  //GoingBacwards
  if(y < 400)
  {
    digitalWrite(22, LOW);
    digitalWrite(24, LOW);
    digitalWrite(26, LOW);
    digitalWrite(28, LOW);
    //Turning
    if(x < 430)
    {
      analogWrite(3, 80);
      analogWrite(5, 80);
    }
    else
    {
      analogWrite(3, 150);
      analogWrite(5, 150);
    }
    if(x > 530)
    {
      analogWrite(2, 80);
      analogWrite(4, 80);
    }
    else
    {
      analogWrite(2, 150);
      analogWrite(4, 150);
    }
  }
  //Staying Still
  if(y > 400 && y < 600)
  {
    analogWrite(2, 0);
    analogWrite(3, 0);
    analogWrite(4, 0);
    analogWrite(5, 0);
  }
  
  Serial.print(x);
  Serial.print("\t");
  Serial.println(y);
  delay(100);
}
