import matplotlib.pyplot as plt
import pandas as pd

# 1. Load the data safely (fixes the KeyError)
# It assigns headers to your 3 data columns and strips out hidden spaces
file_path = r"C:\Users\jvher\Downloads\log14.p" # Update to your data file path if different
try:
    df = pd.read_csv(
        file_path,
        header=None,
        names=["X", "Y", "Z"],
        skipinitialspace=True,
    )
except Exception as e:
    print(f"Error reading file: {e}")
    exit()

# 2. Extract your coordinates
x = df["X"]
y = df["Y"]
z = df["Z"]

# 3. Create the 3D plot
fig = plt.figure(figsize=(10, 7))
ax = fig.add_subplot(111, projection="3d")

# Plot the data as a continuous 3D line
ax.plot(x, y, z, label="3D Trajectory", color="blue", linewidth=2)

# Add a scatter plot on top to see individual data points (optional)
ax.scatter(x, y, z, color="red", s=10, alpha=0.5)

# Label the axes
ax.set_xlabel("X Axis")
ax.set_ylabel("Y Axis")
ax.set_zlabel("Z Axis")
ax.set_title("3D Plot of X, Y, Z Coordinates")
ax.legend()

# 4. Display the interactive window
plt.show()
