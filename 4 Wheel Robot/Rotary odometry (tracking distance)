// Left side
// Hardware Pins
const int ENCODER_LEFT_A = 2; 
const int ENCODER_LEFT_B = 3;
// Telemetry Variables
volatile long LeftTicks = 0;

// Right side
// Hardware Pins
const int ENCODER_RIGHT_A = 4; 
const int ENCODER_RIGHT_B = 5;
// Telemetry Variables
volatile long RightTicks = 0;


// mm per tick (471.24 / 537.6) or (pi x diameter(mm) / total ticks per revolution)
const double DISTANCE_PER_TICK = 0.876559;
void SetupRotary()
{
  pinMode(ENCODER_LEFT_A, INPUT_PULLUP);
  pinMode(ENCODER_LEFT_B, INPUT_PULLUP);
  pinMode(ENCODER_RIGHT_A, INPUT_PULLUP);
  pinMode(ENCODER_RIGHT_B, INPUT_PULLUP);
  
  // Trigger interrupt when Signal A changes from LOW to HIGH
  attachInterrupt(digitalPinToInterrupt(ENCODER_LEFT_A), doLeftEncoder, RISING);
  attachInterrupt(digitalPinToInterrupt(ENCODER_RIGHT_A), doRightEncoder, RISING);
}

void ControlRotary() {
  // Calculate real-world distance
  static unsigned long previousMillis = 0;
  unsigned long currentMillis = millis();
  int interval = 100;

  if (currentMillis - previousMillis >= interval)
 {
  Long averageTicks = (LeftTicks + RightTicks) / 2;

  double distanceTraveled = averageTicks * DISTANCE_PER_TICK;
  
  Serial.print(averageTicks);
  Serial.print(",");
  Serial.print((distanceTraveled / 1000));
  previousMillis = currentMillis;
 }
}

void doLeftEncoder() {
  if(digitalRead(Encoder_LEFT_B) == LOW)
    LeftTicks++;
  else
    LeftTicks--;
}

void doRightEncoder() {
  if(digitalRead(Encoder_RIGHT_B) == LOW)
    RightTicks++;
  else
    RightTicks--;
}
