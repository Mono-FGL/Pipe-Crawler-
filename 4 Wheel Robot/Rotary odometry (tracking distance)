// Hardware Pins
const int ENCODER_A = 2; 
const int ENCODER_B = 3;

// Telemetry Variables
volatile long encoderTicks = 0;
const double DISTANCE_PER_TICK = 0.876559; // mm per tick (471.24 / 537.6)

void SetupRotary()
{
  pinMode(ENCODER_A, INPUT_PULLUP);
  pinMode(ENCODER_B, INPUT_PULLUP);
  
  // Trigger interrupt when Signal A changes from LOW to HIGH
  attachInterrupt(digitalPinToInterrupt(ENCODER_A), doEncoder, RISING);

  pinMode(8, OUTPUT);
  pinMode(9, OUTPUT);
}

void ControlRotary() {
  // Calculate real-world distance
  double distanceTraveled = encoderTicks * DISTANCE_PER_TICK;
  
  Serial.print("Ticks: ");
  Serial.print(encoderTicks);
  Serial.print(" | Distance: ");
  Serial.print((distanceTraveled / 1000));
  Serial.print(" m");
  Serial.print(" | Displacement: ");
  Serial.println();
  
  delay(100); // Simple telemetry delay

  digitalWrite(8, LOW);
  analogWrite(9, 150);
  delay(1000);
  
  digitalWrite(8, HIGH);
  analogWrite(9, 150);
  delay(1000);
}

// ISR: Runs instantly every time Signal A goes HIGH
void doEncoder() {
  // If A and B are different, motor is spinning forward
  /* As soon as B changes it evaluates and sends it to false
     else A returns true and ticks++
  */
  // if (digitalRead(ENCODER_A) != digitalRead(ENCODER_B)) {
  //   encoderTicks++;
  // } else {
  //   encoderTicks--;
  // }
  encoderTicks++;
}
