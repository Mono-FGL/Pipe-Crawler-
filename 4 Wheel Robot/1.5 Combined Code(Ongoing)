//Main_Robot.ino
#include <DHT.h>
#include <Adafruit_Sensor.h>

//initiailize
DHT dht(7, DHT11); // (pin, DhtType)

void setup(){
  Serial.begin(9600);
  dht.begin();
  analogReadResolution(10);
  SetupMotors();
  SetupDHT();
}

void loop(){
  ControlMotors();
  ControlDHT();
}

//TempHumidSens.ino
void SetupDHT()
{
  Serial.println("Begin Test");
}

void ControlDHT()
{
  static unsigned long previousMillis = 0;
  unsigned long currentMillis = millis();
  int interval = 2000;

  if(currentMillis - previousMillis >= interval)
  {
    Serial.println();
  
    float temp = dht.readTemperature();
    float humidity = dht.readHumidity();
  
    Serial.print(F("Temperature: "));
    Serial.println(temp);
    Serial.print(F("Humidity: "));
    Serial.println(humidity);

    previousMillis = currentMillis;
  }
}

//MotorControl.ino
void SetupMotors()
{
    // Pins for motor speed
  pinMode(2, OUTPUT);
  pinMode(3, OUTPUT);
  pinMode(4, OUTPUT);
  pinMode(5, OUTPUT);
  // Pins for HIGH or LOW
  pinMode(22, OUTPUT);
  pinMode(24, OUTPUT);
  pinMode(26, OUTPUT);
  pinMode(28, OUTPUT);
}

void ControlMotors()
{
  float x = analogRead(A2) - 237;  
  float y = analogRead(A1) - 272;

  //State 1: GoingFoward
  if(y > 600)
  {
    //Turning Left
    if(x < 300)
    {
      analogWrite(3, 75);
      analogWrite(5, 75);
      analogWrite(2, 250);
      analogWrite(4, 250);

    digitalWrite(22, HIGH);
    digitalWrite(24, LOW);
    digitalWrite(26, HIGH);
    digitalWrite(28, LOW);
    }
    //Turning Right
    else if(x > 650)
    {
      analogWrite(2, 75);
      analogWrite(4, 75);
      analogWrite(3, 250);
      analogWrite(5, 250);
     
      digitalWrite(22, LOW);
      digitalWrite(24, HIGH);
      digitalWrite(26, LOW);
      digitalWrite(28, HIGH);
    }
    //Straight Foward
    else
    {
      analogWrite(2, 200);
      analogWrite(4, 200);
      analogWrite(3, 200);
      analogWrite(5, 200);

      digitalWrite(22, HIGH);
      digitalWrite(24, HIGH);
      digitalWrite(26, HIGH);
      digitalWrite(28, HIGH);
    }
  }
  //State 2: GoingBacwards
  else if(y < 300)
  {
    //Turning Left While Reversing
    if(x < 300)
    {
      analogWrite(3, 75);
      analogWrite(5, 75);
      analogWrite(2, 250);
      analogWrite(4, 250);

      digitalWrite(22, HIGH);
      digitalWrite(24, LOW);
      digitalWrite(26, HIGH);
      digitalWrite(28, LOW);
    }
    //Turning Right While Reversing
    else if(x > 650)
    {
      analogWrite(2, 75);
      analogWrite(4, 75);
      analogWrite(3, 250);
      analogWrite(5, 250);

     digitalWrite(22, LOW);
      digitalWrite(24, HIGH);
      digitalWrite(26, LOW);
      digitalWrite(28, HIGH);
    }
    //Straight Backwards
    else
    {
      analogWrite(2, 200);
      analogWrite(4, 200);
      analogWrite(3, 200);
      analogWrite(5, 200);

      digitalWrite(22, LOW);
      digitalWrite(24, LOW);
      digitalWrite(26, LOW);
      digitalWrite(28, LOW);
    }
  }
  //State 3: Staying Still
  else
  {
    analogWrite(2, 0);
    analogWrite(3, 0);
    analogWrite(4, 0);
    analogWrite(5, 0);
  }
  //Non-blocking "delay"
  static unsigned long previousMillis = 0;
  unsigned long currentMillis = millis();
  int interval = 500;

  if(currentMillis - previousMillis >= interval)
  {
    previousMillis = currentMillis;
    Serial.print(x);
    Serial.print("\t");
    Serial.println(y);
  }
}
