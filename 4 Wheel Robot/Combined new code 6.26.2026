Quat normalize(Quat q) {
  double mag = sqrt(q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z);
  // Prevent division if already somehow 0
  if (mag == 0) {
    return { 1.0, 0.0, 0.0, 0.0 };
  }
  q.w = q.w / mag;
  q.x = q.x / mag;
  q.y = q.y / mag;
  q.z = q.z / mag;
  return q;
}

double quat_dot(Quat q1, Quat q2) {
  return q1.w * q2.w + q1.x * q2.x + q1.y * q2.y + q1.z * q2.z;
}

double angular_distance(Quat q_ref, Quat q_curr) {
  //Take reference orientation and current orientation to compare against
  //Normalize meaning to convert into vector units
  q_ref = normalize(q_ref);
  q_curr = normalize(q_curr);
  double dot = quat_dot(q_ref, q_curr);
  //Get Absolute value
  dot = fabs(dot);
  //So it doesn't crash must be <= 1 or >= -1 
  if (dot > 1.0) dot = 1.0;
  if (dot < -1.0) dot = -1.0;
  // acos(Arc Cosine) converts into radians
  double angle_radians = 2.0 * acos(dot);
  // Converts Radians to Degrees
  return angle_radians * (180.0 / PI);
}

float MotorSpeed = 150;
// 0 = straight, 1 = Left, 2 = Right
// Able to reset MotorSpeed or left and right
static int LastTurn = 0;

void SetupMotors()
{
  // Pins for motor speed
  pinMode(2, OUTPUT);
  pinMode(3, OUTPUT);
  pinMode(4, OUTPUT);
  pinMode(5, OUTPUT);
  // Pins for HIGH or LOW
  pinMode(22, OUTPUT);
  pinMode(24, OUTPUT);
  pinMode(26, OUTPUT);
  pinMode(28, OUTPUT);
}

void ControlMotors()
{
  float x = analogRead(A2) - 237;  
  float y = analogRead(A1) - 272;
  Serial.print("Raw X: "); Serial.print(analogRead(A2));
  Serial.print(" | Raw Y: "); Serial.println(analogRead(A1));

  //State 1: GoingFoward
  if(y > 600)
  {
    digitalWrite(22, HIGH);
    digitalWrite(24, HIGH);
    digitalWrite(26, HIGH);
    digitalWrite(28, HIGH);
    //Turning Left
    if(x < 300)
    {
      if(LastTurn != 1)
      {
        MotorSpeed = 130;
        LastTurn = 1;
      }
      float AdjustedSpeed = Turning();
      digitalWrite(22, LOW);
      digitalWrite(26, LOW);
      analogWrite(2, AdjustedSpeed);
      analogWrite(4, AdjustedSpeed);
      analogWrite(3, 100);
      analogWrite(5, 100);
    }
    //Turning Right
    else if(x > 650)
    {
      if(LastTurn != 2)
      {
        MotorSpeed = 130;
        LastTurn = 2;
      }
      float AdjustedSpeed = Turning();
      digitalWrite(24, LOW);
      digitalWrite(28, LOW);
      analogWrite(3, AdjustedSpeed);
      analogWrite(5, AdjustedSpeed);
      analogWrite(2, 100);
      analogWrite(4, 100);
    }
    //Straight Foward
    else
    {
      MotorSpeed = 130;
      LastTurn = 0;
      analogWrite(2, 130);
      analogWrite(4, 130);
      analogWrite(3, 130);
      analogWrite(5, 130);
    }
  }
  //State 2: GoingBacwards
  else if(y < 300)
  {
    digitalWrite(22, LOW);
    digitalWrite(24, LOW);
    digitalWrite(26, LOW);
    digitalWrite(28, LOW);
    //Turning Left While Reversing
    if(x < 300)
    {
      if(LastTurn != 1)
      {
        MotorSpeed = 130;
        LastTurn = 1;
      }
      float AdjustedSpeed = Turning();
      digitalWrite(24, HIGH);
      digitalWrite(28, HIGH);
      analogWrite(3, AdjustedSpeed);
      analogWrite(5, AdjustedSpeed);
      analogWrite(2, 100);
      analogWrite(4, 100);
    }
    //Turning Right While Reversing
    else if(x > 650)
    {
      if(LastTurn != 2)
      {
        MotorSpeed = 130;
        LastTurn = 2;
      }
      float AdjustedSpeed = Turning();
      digitalWrite(22, HIGH);
      digitalWrite(26, HIGH);
      analogWrite(2, AdjustedSpeed);
      analogWrite(4, AdjustedSpeed);
      analogWrite(3, 100);
      analogWrite(5, 100);
    }

    //Straight Backwards
    else
    {
      MotorSpeed = 130;
      LastTurn = 0;
      analogWrite(2, 130);
      analogWrite(4, 130);
      analogWrite(3, 130);
      analogWrite(5, 130);
    }
  }
  //State 3: Staying Still
  else
  {
    MotorSpeed = 130;
    LastTurn = 0;
    analogWrite(2, 0);
    analogWrite(3, 0);
    analogWrite(4, 0);
    analogWrite(5, 0);
  }
}

float Turning()
{
  static unsigned long previousMillis = 0;
  unsigned long currentMillis = millis();
  int interval = 100;

  if(currentMillis - previousMillis >= interval)
  {
    previousMillis = currentMillis;
    if(MotorSpeed > 50)
    {
      MotorSpeed -= 20;
    }
  }
  return MotorSpeed;
}


// Left side
// Hardware Pins Blue - A, White - B
const int ENCODER_LEFT_A = 10;
const int ENCODER_LEFT_B = 11;
volatile long LeftTicks = 0;

// Right side
// Hardware Pins Blue - 12, White - 13
const int ENCODER_RIGHT_A = 12;
const int ENCODER_RIGHT_B = 13;
volatile long RightTicks = 0;

// 537.6(TPR) (pi x diameter(mm) / total ticks per revolution)
const float DISTANCE_PER_TICK = 0.92331034089;  // (mm/TPR)
float Distance = 0;

long prev_left = 0;
long prev_right = 0;

//Only reads one wire change at a time 
void doLeftEncoder() {
  static uint8_t last_state = 0; //Need to keep track of this
  uint8_t A = digitalRead(ENCODER_LEFT_A);
  uint8_t B = digitalRead(ENCODER_LEFT_B);
  uint8_t state = (A << 1) | B; //Smash the 2 bits data into 1 bit
  // Moving Fowards so bits going left <<
  if((last_state == 0 && state == 1) || //OR
     (last_state == 1 && state == 3) ||
     (last_state == 3 && state == 2) ||
     (last_state == 2 && state == 0))
  {
    LeftTicks++;
  }
  else if// Moving Backwards so reverse bits going to right >>
    ((last_state == 0 && state == 2) || //OR
     (last_state == 2 && state == 3) ||
     (last_state == 3 && state == 1) ||
     (last_state == 1 && state == 0 ))
  {
    LeftTicks--;
  }
  last_state = state;
}

void doRightEncoder() {
  static uint8_t last_state = 0; //Need to keep track of this
  uint8_t A = digitalRead(ENCODER_RIGHT_A);
  uint8_t B = digitalRead(ENCODER_RIGHT_B);
  uint8_t state = (A << 1) | B; //Smash the 2 bits data into 1 bit
  // Moving Fowards so bits going left <<
  if((last_state == 0 && state == 1) || //OR
     (last_state == 1 && state == 3) ||
     (last_state == 3 && state == 2) ||
     (last_state == 2 && state == 0))
  {
    RightTicks--;
  }
  else if// Moving Backwards so reverse bits going to right >>
    ((last_state == 0 && state == 2) || //OR
     (last_state == 2 && state == 3) ||
     (last_state == 3 && state == 1) ||
     (last_state == 1 && state == 0))
  {
    RightTicks++;
  }
  last_state = state;
}

void SetupRotary() {
  pinMode(ENCODER_LEFT_A, INPUT_PULLUP);
  pinMode(ENCODER_LEFT_B, INPUT_PULLUP);
  pinMode(ENCODER_RIGHT_A, INPUT_PULLUP);
  pinMode(ENCODER_RIGHT_B, INPUT_PULLUP);

  // Trigger interrupt when Signal A changes from LOW to HIGH (Quadrature)
  attachInterrupt(digitalPinToInterrupt(ENCODER_LEFT_A), doLeftEncoder, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENCODER_RIGHT_A), doRightEncoder, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENCODER_LEFT_B), doLeftEncoder, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENCODER_RIGHT_B), doRightEncoder, CHANGE);
}

float GetEncoderData()
{
  // Cant be intterupted, 32 bits but CPU only reads 8 bits at time
  noInterrupts();
  long current_left = LeftTicks;
  long current_right = RightTicks;
  interrupts();

    /* Find the average tick change by finding the difference of total ticks
  minus previous total ticks. Then multiply by total distance per tick (fixed number)
  */
  float delta_left = current_left - prev_left;
  float delta_right = current_right - prev_right;
  float AverageTickChange = (delta_left + delta_right) / 2;
  float delta_meters = (AverageTickChange * DISTANCE_PER_TICK) / 1000; 
  
  prev_left = current_left;
  prev_right = current_right;
  Distance += delta_meters;

  //Millis for only Serial.print
  static unsigned long previousMillis = 0;
  unsigned long currentMillis = millis();
  const unsigned int interval = 300;
  if (currentMillis - previousMillis >= interval) {

  // Serial.print(current_left);
  // Serial.print("\t");
  // Serial.print(current_right);
  // Serial.print("\t");
  // Serial.print("Tick Change: ");
  // Serial.print(AverageTickChange);
  // Serial.print(",");
  Serial.print("Distance: ");
  Serial.print(Distance);
  Serial.println("M");
  previousMillis = currentMillis;
  }

  return delta_meters; //How far moved from last point
}

//Use Adafruit_BNO055 class to create variable called bno
// 55 is the arbitrary sensor ID number 
// Blue SDA - 20
// Yellow SLC - 21
#include <Adafruit_BNO055.h>
#include <utility/imumaths.h>
extern Adafruit_BNO055 bno;

void SetupIMU() 
{
  if(!bno.begin())
  {
    //Problem detected
    Serial.print("BNO not found, check connection");
    while(1);
  }
  //Sets mode to NDOF(Nine degrees of freedom)
  bno.setMode(OPERATION_MODE_NDOF);
    //Uses external crystal for better accuracy
  bno.setExtCrystalUse(true);
  //Calibration (all must equal 3)
  uint8_t system = 0, gyro = 0, accel = 0, mag = 0;
  while(system < 3 || gyro < 3 || accel < 3 || mag < 3) // ! skips scope
  { 
  bno.getCalibration(&system, &gyro, &accel, &mag);
  Serial.print("Calibration: Sys="); Serial.print(system);
  Serial.print(" Gyro="); Serial.print(gyro);
  Serial.print(" Accel="); Serial.print(accel);
  Serial.print(" Mag="); Serial.println(mag);
  }
  Serial.println("Calibration Complete");
  for(int i = 0; i < 0; i++)
  {
    Serial.println(i);
    delay(1000);
  }
}

