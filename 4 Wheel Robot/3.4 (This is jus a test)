#include <kvstore_global_api.h>

#define KEY_BNO_ID "/kv/bno_id" // Puts KEY_BNO_ID into the drawer named /kv/bno_id
#define KEY_BNO_CALIB "/kv/bno_calib" // puts KEY_BNO_CALIB into drawer named /kv/bno_calib

Adafruit_BNO055 bno = Adafruit_BNO055(55, 0x28);

long bnoID; // ID for chip
bool foundCalib = false; 
/* 
  Stores and saves raw calibration data (offsets and radius)
   Creates CalibrationData as bno055_offsets_t
*/
adafruit_bno055_offsets_t CalibrationData;

/* Initializes and starts up BNO */
void BNO_055INIT()
{
// Check if BNO is present 
if (!bno.begin())
  {
    Serial.println("No BNO detected, check wiring or I2C adress");
    while(1);
  }
  bno.setMode(OPERATION_MODE_NDOF); // 9 Degrees of freedom
  bno.setExtCrystalUse(true); // Use external crystal more accurate
}

/* Calibrate BNO */
void BNO_CALIB()
{
  uint8_t system = 0, gyro = 0, accel = 0, mag = 0;
  while(system < 3 || gyro < 3 || accel < 3 || mag < 3) // ! skips scope
  { 
  bno.getCalibration(&system, &gyro, &accel, &mag);
  Serial.print("Calibration: Sys="); Serial.print(system);
  Serial.print(" Gyro="); Serial.print(gyro);
  Serial.print(" Accel="); Serial.print(accel);
  Serial.print(" Mag="); Serial.println(mag);
  delay(100);
  }
  Serial.println("Calibration Complete");
  for(int i = 0; i < 3; i++)
  {
    Serial.println(i);
    delay(1000); 
  }
}
/* Fetch ID and if it matches then fetches the Calibration Data */
void GET_CALIB_DATA()
{
  // 
  sensor_t sensor; 
  bno.getSensor(&sensor); // Get sensor hardware info (including ID)
  size_t actual_size = 0; // Keep track of size 

  /* 
    KEY_BNO_ID    - Look up kv/bno_ID
     &bnoId        - Where to write the retieved value (output buffer)
     sizeof(bnoID) - Max number of bytes buffer can hold 
     &actual_size  - KVStore writes back how many bytes it actually found 
  */
  int result = kv_get(KEY_BNO_ID, &bnoID, sizeof(bnoID), &actual_size);

  // Result buffer equals 0 or ID did not match --> recalibrate IMU
  if(result < 0 || bnoID != sensor.sensor_id)
  {
    Serial.println("No matching Calibration data found in KV store");
    BNO_CALIB();
  }
  else
  {
    // Fetch the calibration data  
    result = kv_get(KEY_BNO_CALIB, &CalibrationData, sizeof(CalibrationData), &actual_size);
    // result returns 0 if successful 
    if(result == 0 && actual_size == sizeof(CalibrationData))
    {
      bno.setSensorOffsets(CalibrationData);
      foundCalib = true;
      Serial.println("Calibration data loaded from KV store.");
    }
    else
    {
      Serial.println("KV Calibration data corrupted or missing size mismatch");
      BNO_CALIB();
    }
  }
}
  
/* 
  Retrieve Calibration Data --> get space to where to put in --> Write Calibration Data into space  
*/
void SAVE_CALIB_DATA()
{
  sensor_t sensor;
  bno.getSensor(&sensor);
  bnoID = sensor.sensor_id;
  // Get sensor
  bno.getSensorOffsets(CalibrationData);
  /*
    KEY_BNO_ID     - Which slot to Write into
     &bnoId        - What bytes to copy in
     sizeof(bnoID) - How many bytes to write
     0             - 0 = default(No special flags)
  */
  int result1 = kv_set(KEY_BNO_ID, &bnoID, sizeof(bnoID), 0);
  int result2 = kv_set(KEY_BNO_CALIB, &CalibrationData, sizeof(CalibrationData), 0);
  if(result1 == 0 && result2 == 0)
  {
    Serial.println("Calibration saved to KV store");
  }
  else
  {
    Serial.println("Failed to write Calibration into KV store");
  }
}

/* 
Rotary Encoders are read via interupts. Uses quadature encoder and waits for hardware interrupts.
Uses state machine to determine if moving foward or backwards for both Left and Right sides  
*/

// Left side
// Hardware Pins Blue - A, White - B
const int ENCODER_LEFT_A = 10;
const int ENCODER_LEFT_B = 11;
volatile long LeftTicks = 0;

// Right side
// Hardware Pins Blue - 12, White - 13
const int ENCODER_RIGHT_A = 12;
const int ENCODER_RIGHT_B = 13;
volatile long RightTicks = 0;

/*
Large robot: (pi x diameter(mm)) / 537.6(TPR) 
Small robot: (pi x 188.495559mm) / 484(TPR) = 1.22350467642 mm/TPR
*/
const float DISTANCE_PER_TICK = 0.92331034089;  // (mm/TPR)
float Distance = 0;

long prev_left = 0;
long prev_right = 0;

//Only reads one wire change at a time 
void doLeftEncoder() {
  static uint8_t last_state = 0; //Need to keep track of this
  uint8_t A = digitalRead(ENCODER_LEFT_A);
  uint8_t B = digitalRead(ENCODER_LEFT_B);
  uint8_t state = (A << 1) | B; //Smash the 2 bits data into 1 bit
  // Moving Fowards so bits going left <<
  if((last_state == 0 && state == 1) || //OR
     (last_state == 1 && state == 3) ||
     (last_state == 3 && state == 2) ||
     (last_state == 2 && state == 0))
  {
    LeftTicks++;
  }
  else if// Moving Backwards so reverse bits going to right >>
    ((last_state == 0 && state == 2) || //OR
     (last_state == 2 && state == 3) ||
     (last_state == 3 && state == 1) ||
     (last_state == 1 && state == 0 ))
  {
    LeftTicks--;
  }
  last_state = state;
}

void doRightEncoder() {
  static uint8_t last_state = 0; //Need to keep track of this
  uint8_t A = digitalRead(ENCODER_RIGHT_A);
  uint8_t B = digitalRead(ENCODER_RIGHT_B);
  uint8_t state = (A << 1) | B; //Smash the 2 bits data into 1 bit
  // Moving Fowards so bits going left <<
  if((last_state == 0 && state == 1) || //OR
     (last_state == 1 && state == 3) ||
     (last_state == 3 && state == 2) ||
     (last_state == 2 && state == 0))
  {
    RightTicks--;
  }
  else if// Moving Backwards so reverse bits going to right >>
    ((last_state == 0 && state == 2) || //OR
     (last_state == 2 && state == 3) ||
     (last_state == 3 && state == 1) ||
     (last_state == 1 && state == 0))
  {
    RightTicks++;
  }
  last_state = state;
}

void SetupRotary() {
  pinMode(ENCODER_LEFT_A, INPUT_PULLUP);
  pinMode(ENCODER_LEFT_B, INPUT_PULLUP);
  pinMode(ENCODER_RIGHT_A, INPUT_PULLUP);
  pinMode(ENCODER_RIGHT_B, INPUT_PULLUP);

  // Trigger interrupt when Signal A changes from LOW to HIGH (Quadrature)
  attachInterrupt(digitalPinToInterrupt(ENCODER_LEFT_A), doLeftEncoder, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENCODER_RIGHT_A), doRightEncoder, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENCODER_LEFT_B), doLeftEncoder, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENCODER_RIGHT_B), doRightEncoder, CHANGE);
}

float GetEncoderData()
{
  // Cant be intterupted, 32 bits but CPU only reads 8 bits at time
  noInterrupts();
  long current_left = LeftTicks;
  long current_right = RightTicks;
  interrupts();

    /* Find the average tick change by finding the difference of total ticks
  minus previous total ticks. Then multiply by total distance per tick (fixed number)
  */
  float delta_left = current_left - prev_left;
  float delta_right = current_right - prev_right;
  float AverageTickChange = (delta_left + delta_right) / 2;
  float delta_meters = (AverageTickChange * DISTANCE_PER_TICK) / 1000; 
  
  prev_left = current_left;
  prev_right = current_right;
  Distance += delta_meters;

  //Millis for only Serial.print
  // static unsigned long previousMillis = 0;
  // unsigned long currentMillis = millis();
  // const unsigned int interval = 300;
  // if (currentMillis - previousMillis >= interval) {

  // // Serial.print(current_left);
  // // Serial.print("\t");
  // // Serial.print(current_right);
  // // Serial.print("\t");
  // // Serial.print("Tick Change: ");
  // // Serial.print(AverageTickChange);
  // // Serial.print(",");
  // Serial.print("Distance: ");
  // Serial.print(Distance);
  // Serial.println("M");
  // previousMillis = currentMillis;
  // }

  return delta_meters; //How far moved from last point
}

