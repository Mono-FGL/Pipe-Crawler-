// This gives how far drifted from starting point (No direction just magnitude)
// Good for diagnostics/sensor fusion
// Foward Declaration(Function Prototypes)
Quat normalize(Quat q);
double quat_dot(Quat q1, Quat q2);
double angular_distance(Quat q_ref, Quat q_curr);
double getYaw(imu::Quaternion q);
extern float Distance;

// Converts quat to Euler angles
double getYaw(imu::Quaternion q)
{
  //Sine of yaw times cosine of pitch = that
  // q.w() instead of q.w because it has to go fetch the value
  double siny_cosp = 2.0 * (q.w() * q.z() + q.x() * q.y()); // Calculates Left/Right positioning on flat grid
  // Cosine of yaw times cosine of pitch = that
  double cosy_cosp = 1.0 - 2.0 * (q.y() * q.y() + q.z() * q.z()); // Calculates Foward and Back positioning on flat grid
  // atan2 is arctan(atan), the 2 checks both numbers and their signs for a 4 quadrant map
  // arctan reverts distance on flat grid into steering angle (Raw spatial coordinates into a single usable angle ex: 45 degrees)
  return atan2(siny_cosp, cosy_cosp); //Converts to Radian 
}

double getPitch(imu::Quaternion q)
{
  // sin pitch
  double sinp = 2.0 * (q.w() * q.y() - q.z() * q.x());
  // Keep withing radian 
  if (sinp >= 1.0) 
    return PI / 2.0;
  if (sinp <= -1.0) 
    return -PI / 2.0;
  return asin(sinp); // Arcsine turns into angle
}

// Take data type imu::Quaternion named quat and deltaA_meters from rotary encoder
void ControlQuat(imu::Quaternion quat, float delta_meters) {
  //Pack into custom Quat structure (current_orientation is under Quat type)
  current_orientation.w = quat.w();
  current_orientation.x = quat.x();
  current_orientation.y = quat.y();
  current_orientation.z = quat.z();

  //Lock reference orientation and yaw on first run
  if (!isReferenceSet) {
    reference_orientation = current_orientation;
    ref_yaw = getYaw(quat);
    ref_pitch = getPitch(quat);
    isReferenceSet = true;
    Serial.println("Reference heading locked");
  }


  double raw_yaw = getYaw(quat); //Radian
  double raw_pitch = getPitch(quat);

  double real_yaw = raw_yaw - ref_yaw;  // Find angle of Yaw difference from starting point
  double real_pitch = raw_pitch - ref_pitch;

  // Correct radian wrap-around check (-PI -> +PI)
  while(real_yaw > PI)
    real_yaw -= 2.0 * PI;
  while(real_yaw < -PI)
    real_yaw += 2.0 * PI;

  // Dead Reckoning (In radians)
  pos_x += delta_meters * cos(real_pitch) * cos(real_yaw);
  pos_y += delta_meters * cos(real_pitch) * sin(real_yaw);
  pos_z += delta_meters * sin(real_pitch);

  static unsigned long previousMillis = 0;
  unsigned long currentMillis = millis();

  if (currentMillis - previousMillis >= 300) {
    previousMillis = currentMillis;
    // Serial.print("Yaw: ");
    // Serial.print(real_yaw, 2);
    // Serial.print(" X: ");
    Serial.print(pos_x, 3);
    Serial.print("\t");
    Serial.print(pos_y, 3);
    Serial.print("\t");
    Serial.println(pos_z, 3);
    // Serial.print(" Dist: ");
    // Serial.print(Distance, 3);
    // Serial.print(" Drift3D: ");
    // Serial.println(drift_deg, 2);

    // Log data to file safely
    if (f != NULL) {
      fprintf(f, "%.4f, %.4f, %.4f\n", pos_x, pos_y, pos_z);
      
      // CRITICAL: Empty the RAM buffer and force an immediate physical save
      fflush(f); 
      fsync(fileno(f)); 
    }
  }
}

float MotorSpeed = 35;
// 0 = straight, 1 = Left, 2 = Right
// Able to reset MotorSpeed or left and right
static int LastTurn = 0;

void SetupMotors()
{
  // Pins for motor speed
  pinMode(2, OUTPUT);
  pinMode(3, OUTPUT);
  pinMode(4, OUTPUT);
  pinMode(5, OUTPUT);
  // Pins for HIGH or LOW
  pinMode(22, OUTPUT);
  pinMode(24, OUTPUT);
  pinMode(26, OUTPUT);
  pinMode(28, OUTPUT);
}

void ControlMotors()
{
  float x = analogRead(A2) - 237;  
  float y = analogRead(A1) - 272;
  Serial.print("Raw X: "); Serial.print(analogRead(A2));
  Serial.print(" | Raw Y: "); Serial.println(analogRead(A1));

  //State 1: GoingFoward
  if(y > 600)
  {
    digitalWrite(22, HIGH);
    digitalWrite(24, HIGH);
    digitalWrite(26, HIGH);
    digitalWrite(28, HIGH);
    //Turning Left
    if(x < 300)
    {
      if(LastTurn != 1)
      {
        MotorSpeed = 25;
        LastTurn = 1;
      }
      float AdjustedSpeed = Turning();
      digitalWrite(22, LOW);
      digitalWrite(26, LOW);
      analogWrite(2, AdjustedSpeed);
      analogWrite(4, AdjustedSpeed);
      analogWrite(3, 150);
      analogWrite(5, 150);
    }
    //Turning Right
    else if(x > 650)
    {
      if(LastTurn != 2)
      {
        MotorSpeed = 35;
        LastTurn = 2;
      }
      float AdjustedSpeed = Turning();
      digitalWrite(24, LOW);
      digitalWrite(28, LOW);
      analogWrite(3, AdjustedSpeed);
      analogWrite(5, AdjustedSpeed);
      analogWrite(2, 150);
      analogWrite(4, 150);
    }
    //Straight Foward
    else
    {
      MotorSpeed = 35;
      LastTurn = 0;
      analogWrite(2, 130);
      analogWrite(4, 130);
      analogWrite(3, 130);
      analogWrite(5, 130);
    }
  }
  //State 2: GoingBacwards
  else if(y < 300)
  {
    digitalWrite(22, LOW);
    digitalWrite(24, LOW);
    digitalWrite(26, LOW);
    digitalWrite(28, LOW);
    //Turning Left While Reversing
    if(x < 300)
    {
      if(LastTurn != 1)
      {
        MotorSpeed = 35;
        LastTurn = 1;
      }
      float AdjustedSpeed = Turning();
      digitalWrite(22, HIGH);
      digitalWrite(26, HIGH);
      analogWrite(2, AdjustedSpeed);
      analogWrite(4, AdjustedSpeed);
      analogWrite(3, 150);
      analogWrite(5, 150);
    }
    //Turning Right While Reversing
    else if(x > 650)
    {
      if(LastTurn != 2)
      {
        MotorSpeed = 35;
        LastTurn = 2;
      }
      float AdjustedSpeed = Turning();
      digitalWrite(24, HIGH);
      digitalWrite(28, HIGH);
      analogWrite(3, AdjustedSpeed);
      analogWrite(5, AdjustedSpeed);
      analogWrite(2, 150);
      analogWrite(4, 150);
    }

    //Straight Backwards
    else
    {
      MotorSpeed = 35;
      LastTurn = 0;
      analogWrite(2, 130);
      analogWrite(4, 130);
      analogWrite(3, 130);
      analogWrite(5, 130);
    }
  }
  //State 3: Staying Still
  else
  {
    MotorSpeed = 35;
    LastTurn = 0;
    analogWrite(2, 0);
    analogWrite(3, 0);
    analogWrite(4, 0);
    analogWrite(5, 0);
  }
}

float Turning()
{
  static unsigned long previousMillis = 0;
  unsigned long currentMillis = millis();
  int interval = 100;

  if(currentMillis - previousMillis >= interval)
  {
    previousMillis = currentMillis;
    if(MotorSpeed <= 85)
    {
      MotorSpeed += 5;
    }
  }
  return MotorSpeed;
}

#include <Wire.h>
#include <Adafruit_Sensor.h>
